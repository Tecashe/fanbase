# Neon Postgres + Prisma Connection String (Serverless Pooler)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/campfire?sslmode=require"

# YouTube Data API v3 & Google OAuth (youtube.readonly scope)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# Application Host URL (for OAuth redirect callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Scheduled 30-Day YouTube Re-verification Cron Secret
CRON_SECRET="campfire_cron_secret_key"
